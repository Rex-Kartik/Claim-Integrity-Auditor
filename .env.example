# Comma-separated Gemini API keys from different GCP projects
# Each key should belong to a different GCP project for rate-limit rotation to help
GEMINI_API_KEYS=your-key-1-here,your-key-2-here

# Cooldown in seconds for a key that hit a rate limit (default 300)
GEMINI_KEY_COOLDOWN_SECONDS=300

# Optional: comma-separated model candidates to probe in order
# If unset, all models supporting generateContent are probed
# GEMINI_MODEL_CANDIDATES=gemini-1.5-flash,gemini-1.5-pro
